{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deskbot.world-event-package.v1",
  "title": "DeskBot authored world event package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "version", "title", "kind", "event_template", "activation", "actions", "provenance"],
  "properties": {
    "package_id": { "type": "string", "pattern": "^[-a-z0-9]+-v[0-9]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string", "minLength": 1 },
    "expires_after_hours": { "type": "integer", "minimum": 1, "maximum": 720 },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_types", "required_any_tags", "min_confidence"],
      "properties": {
        "observation_types": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_any_tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "event_template": {
      "type": "object", "additionalProperties": true,
      "required": ["event_id", "title", "summary", "arc_id", "status"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "arc_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "actions": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["action"],
        "properties": { "action": { "enum": ["apply_world_line_event", "enqueue_pending_item", "record_external_context"] }, "event_template": { "type": "string" } } }
    }
  }
}
