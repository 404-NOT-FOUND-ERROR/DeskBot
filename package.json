{
  "name": "deskbot",
  "version": "0.1.0",
  "private": true,
  "description": "DeskBot · 聚形域：现实多源输入折射进持续奇幻小镇，驱动潮玩生命体的生活、记忆、关系与形态/职业探索。Node.js + SQLite + React/Three.js；Asamana-inspired 感知、慢认知、跨日目标与可核验回放。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1 -StartWeb",
    "start:service": "npm.cmd --prefix apps/deskbot-service start",
    "start:web": "npm.cmd --prefix apps/deskbot-web start",
    "start:world": "npm.cmd --prefix apps/jev-town-client run dev:deskbot",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests.ps1",
    "test:service": "npm.cmd --prefix apps/deskbot-service test",
    "test:voice": "python -m unittest discover -s voice-sidecar/tests -v",
    "package:source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1"
  }
}
