    "position":{"uses":["choice_context"],"bucket":"context_evidence_ids"},
    "speculation":{"uses":["idea_context"],"bucket":"context_evidence_ids"}
  },
  "errors":{"unavailable":"evidence_ref_unavailable","stale":"evidence_ref_stale","use":"evidence_ref_wrong_use"}
}
