# Copy this file to weather.env and replace the token locally.
# This file is ignored by Git. Never paste the token into the web UI or a log.
DESKBOT_WEATHER_ENABLED=true
DESKBOT_WEATHER_PROVIDER=qweather
DESKBOT_WEATHER_TOKEN=PASTE_YOUR_QWEATHER_KEY_HERE
DESKBOT_WEATHER_AUTH_MODE=api-key
DESKBOT_WEATHER_URL=https://YOUR_API_HOST/v7/weather/now
DESKBOT_WEATHER_LATITUDE=31.2304
DESKBOT_WEATHER_LONGITUDE=121.4737
DESKBOT_WEATHER_LOCATION=上海
DESKBOT_WEATHER_TIMEZONE=Asia/Shanghai
