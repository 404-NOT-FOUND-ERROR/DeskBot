# Copy to .env and fill in. The .env file is git-ignored and is read only by the
# Node server process. The key is never sent to the browser and never logged.
TYPESAFE_API_KEY=

# Optional overrides
PORT=8787
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_TIMEOUT_MS=20000
